# TrustAnchor Engine 1 — Backend Environment Configuration
# Copy this file to .env and fill in real values before running the server.
# NEVER commit a real .env file — only this .env.example template.

# PostgreSQL connection string (Prisma format).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trustanchor?schema=public"

# HTTP port the Express server listens on.
PORT=4000

# CORS allowed origin(s) — comma-separated. Use "*" only for local development.
CORS_ORIGIN="*"

# Log level: debug | info | warn | error
LOG_LEVEL="info"

# Node environment: development | production | test
NODE_ENV="development"

# The PLATFORM TRUST KEY's PUBLIC half (safe — public keys are meant to be
# shared). Used only for an optional sanity check on manifest ingestion.
# Get this value by running `npm run keygen` in packages/offline-signer and
# copying the printed "Public key" value, or from samples/platform-key.json's
# publicKeyHex field for the bundled demo key.
PLATFORM_PUBLIC_KEY_HEX=""

# A shared secret required on POST /manifest, POST /credential, POST /asset.
# This is ordinary operational access control (keeps a public deployment
# from being spammed), NOT a cryptographic security boundary — see
# src/middleware/ingestionAuth.ts. Leave blank to disable (local dev only).
INGESTION_API_KEY="dev-ingestion-key-change-me"

# ----------------------------------------------------------------------------
# IMPORTANT — WHAT IS DELIBERATELY *NOT* IN THIS FILE:
# ----------------------------------------------------------------------------
# There is no ISSUER_PRIVATE_KEY, no PLATFORM_PRIVATE_KEY, and no signing
# key of any kind here. This is not an oversight — per the Frozen
# Specification (§5), this runtime must hold NO signing key, in any
# environment, at any time. Every private key used in this system lives
# exclusively on an offline machine running @trustanchor/offline-signer. If
# you find yourself wanting to add a private key to this file, stop — that
# would reintroduce the exact "signing oracle" vulnerability this
# architecture was built to eliminate. See MCC_RUNBOOK.md / README.md for
# the correct offline signing workflow.

# ----------------------------------------------------------------------------
# ENGINE 2 (document forensics) — purely additive, does not affect Engine 1
# ----------------------------------------------------------------------------
# Base URL of the Python engine2-service (packages/engine2-service). Only
# reached from src/routes/v2/verify.ts's engine2Client.ts — never touched by
# any Engine 1 route.
ENGINE2_SERVICE_URL="http://localhost:8000"

# ----------------------------------------------------------------------------
# PORTAL AUTH (issuer/admin web accounts) — purely additive, does not affect
# Engine 1 or Engine 2. This is NOT a credential-signing key — it only signs
# ordinary web session tokens proving "this person already logged in with a
# password." Set to a long random string in any real deployment.
# ----------------------------------------------------------------------------
JWT_SECRET="change-me-to-a-long-random-string"


SEED_ADMIN_EMAIL="admin@trustanchor.local"
SEED_ADMIN_PASSWORD="admin123"