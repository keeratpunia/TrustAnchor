{
  "name": "trustanchor-verifier-app",
  "version": "1.0.0",
  "private": true,
  "description": "TrustAnchor Engine 1 Verifier App — scans a QR code and performs deterministic cryptographic verification entirely against self-authenticating server data (Frozen Spec §14). No signing key ever exists in this app; it only holds hardcoded PUBLIC platform key(s).",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-camera": "~17.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-constants": "~18.0.13",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "tweetnacl": "^1.0.3",
    "js-sha256": "^0.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@types/jest": "^29.5.12"
  }
}
